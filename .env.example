# Bắt buộc — lấy ở https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tuỳ chọn — model sinh/sửa ảnh.
#   gemini-3.1-flash-lite-image  (mặc định) nhanh, rẻ, chỉ xuất 1K
#   gemini-3.1-flash-image       chậm hơn, nét hơn, xuất được 2K
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Tuỳ chọn — chỉ đặt khi dùng model KHÔNG phải bản lite. Giá trị: 1K | 2K | 4K
# Bản lite chỉ hỗ trợ 1K; đặt 2K với bản lite là lỗi từ API.
# GEMINI_IMAGE_SIZE=2K

# Tuỳ chọn — model đọc ảnh (đo landmark + chấm 6 tiêu chí). Không sinh pixel nào.
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# Model dùng khi bật "sinh lại ở độ phân giải cao" (chỉ chế độ ảnh chân dung).
# Bản -lite-image chỉ ra 1K nên không dùng được cho việc này.
# GEMINI_IMAGE_MODEL_HIRES=gemini-3.1-flash-image

# Kho đếm hạn mức dùng chung. KHÔNG đặt thì rơi về bộ nhớ tiến trình — đủ cho
# `npm run dev`, KHÔNG đủ cho production nhiều instance (mỗi instance đếm riêng
# nên trần thật = trần × số instance). Chạy migrations/001_photo_quota.sql trước.
# PHOTO_DATABASE_URL=postgresql://...neon.tech/...?sslmode=require

# Trần chi toàn cục mỗi ngày — đặt theo số tiền tối đa chấp nhận mất trong một
# ngày xấu nhất, KHÔNG theo kỳ vọng lưu lượng.
# PHOTO_GLOBAL_DAILY_CALLS=400
# PHOTO_FREE_DAILY_CALLS=12

# Kho ảnh (Cloudflare R2, giao thức S3). Thiếu thì ảnh trả về dạng data URL như
# cũ — dev chạy được nhưng KHÔNG bền và không có ranh giới bản xem thử/bản sạch.
# Nhớ đặt lifecycle rule tự xoá (vd 7 ngày) trên bucket, nếu không chi phí chỉ tăng.
# PHOTO_R2_ACCOUNT_ID=
# PHOTO_R2_ACCESS_KEY_ID=
# PHOTO_R2_SECRET_ACCESS_KEY=
# PHOTO_R2_BUCKET=

# Nhận tiền bằng chuyển khoản + mã memo. Thiếu thì UI không mời trả tiền.
# PHOTO_BANK_CODE=970436
# PHOTO_BANK_ACCOUNT=
# PHOTO_BANK_NAME=

# Token đánh dấu đơn đã nhận tiền (POST /api/admin/mark-paid, header x-admin-token).
# Không đặt thì route TẮT hẳn.
# PHOTO_ADMIN_TOKEN=

# Đối soát TỰ ĐỘNG qua SePay: tiền về là đơn tự mở khoá, không phải canh sao kê.
# Chuỗi tự đặt (`openssl rand -hex 24`), dán y hệt vào SePay → Webhooks → Api Key.
# KHÔNG đặt thì /api/webhooks/sepay trả 503 — cố ý đóng cửa: webhook không xác
# thực được người gửi là cửa cho người khác tự đánh dấu đơn của mình đã trả.
# Đường tay /api/admin/mark-paid vẫn dùng được làm dự phòng.
# PHOTO_SEPAY_API_KEY=

# Kênh liên hệ khi thanh toán trục trặc — hiện ngay dưới mã QR, kèm mã memo.
# Bắt buộc khi thu tiền: khách chuyển khoản mà webhook lỗi thì phải biết kêu ai.
# PHOTO_SUPPORT_CONTACT=Zalo 0900 000 000
